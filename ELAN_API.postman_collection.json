              "raw": "{{baseUrl}}/api/products?page=1&limit=12",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" },
                { "key": "featured", "value": "true", "disabled": true },
                { "key": "fragranceFamily", "value": "Woody Oriental", "disabled": true },
                { "key": "season", "value": "Winter", "disabled": true },
                { "key": "search", "value": "noir", "disabled": true },
                { "key": "sort", "value": "price-asc", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Product by Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/slug/elan-signature-noir",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "slug", "elan-signature-noir"]
            }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Admin — Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "  pm.collectionVariables.set('productId', res.data._id);",
                  "  console.log('Product ID saved:', res.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ÉLAN Signature Noir\",\n  \"shortDescription\": \"An opulent fragrance combining dark amber and Damask rose.\",\n  \"description\": \"Masterfully crafted fragrance with notes of saffron, Damask rose, and rich dark amber.\",\n  \"fragranceFamily\": \"Woody Oriental\",\n  \"season\": [\"Winter\", \"Evening\"],\n  \"notes\": {\n    \"top\": [\"Saffron\", \"Bergamot\"],\n    \"heart\": [\"Damask Rose\", \"Oud\"],\n    \"base\": [\"Dark Amber\", \"Vanilla\", \"Musk\"]\n  },\n  \"images\": [\n    {\n      \"url\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\",\n      \"publicId\": \"elan/signature_noir\",\n      \"alt\": \"Signature Noir Bottle\"\n    }\n  ],\n  \"variants\": [\n    { \"size\": \"30ml\", \"price\": 850, \"stock\": 50, \"SKU\": \"ELAN-NOIR-30ML\" },\n    { \"size\": \"50ml\", \"price\": 1450, \"stock\": 30, \"SKU\": \"ELAN-NOIR-50ML\" },\n    { \"size\": \"100ml\", \"price\": 2200, \"stock\": 20, \"SKU\": \"ELAN-NOIR-100ML\" }\n  ],\n  \"featured\": true,\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            }
          }
        },
        {
          "name": "Admin — Update Product",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"featured\": true,\n  \"shortDescription\": \"Updated description for this fragrance.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Admin — Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Admin — Low Stock Report",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/products/admin/low-stock?threshold=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "admin", "low-stock"],
              "query": [{ "key": "threshold", "value": "10" }]
            }
          }
        }
      ]
    },
    {
      "name": "📦 Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data._id) {",
                  "  pm.collectionVariables.set('orderId', res.data._id);",
                  "  pm.collectionVariables.set('orderNumber', res.data.orderNumber);",
                  "  console.log('Order ID:', res.data._id);",
                  "  console.log('Order Number:', res.data.orderNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"variantSKU\": \"ELAN-NOIR-50ML\",\n      \"quantity\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"90th Street, Fifth Settlement\",\n    \"city\": \"New Cairo\",\n    \"state\": \"Cairo\",\n    \"postalCode\": \"11835\",\n    \"country\": \"Egypt\"\n  },\n  \"couponCode\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
