    {
      "name": "💳 Fawaterk Payment",
      "item": [
        {
          "name": "Initiate Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.invoiceId) {",
                  "  pm.collectionVariables.set('invoiceId', res.data.invoiceId);",
                  "  console.log('Invoice ID saved:', res.data.invoiceId);",
                  "  console.log('Payment URL:', res.data.paymentUrl);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/fawaterk/initiate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "fawaterk", "initiate"]
            }
          }
        },
        {
          "name": "Webhook — Simulate PAID",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": \"FAW-INV-TEST-001\",\n  \"custom_ref\": \"{{orderNumber}}\",\n  \"invoice_status\": \"PAID\",\n  \"payment_method\": \"card\",\n  \"amount\": 1450,\n  \"currency\": \"EGP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/fawaterk/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "fawaterk", "webhook"]
            }
          }
        },
        {
          "name": "Webhook — Simulate FAILED",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invoice_id\": \"FAW-INV-TEST-002\",\n  \"custom_ref\": \"{{orderNumber}}\",\n  \"invoice_status\": \"failed\",\n  \"payment_method\": \"card\",\n  \"amount\": 1450,\n  \"currency\": \"EGP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/fawaterk/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "fawaterk", "webhook"]
            }
          }
